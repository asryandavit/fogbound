{
  "mcpServers": {
    "godot": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@coding-solo/godot-mcp"
      ],
      "env": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot"
      }
    },
    "godot-forge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "godot-forge"
      ],
      "env": {}
    }
  }
}