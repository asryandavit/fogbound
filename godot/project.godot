; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fogbound"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

Config="*res://autoloads/config.gd"
NetworkManager="*res://autoloads/network_manager.gd"
GameState="*res://autoloads/game_state.gd"
GameFlow="*res://autoloads/game_flow.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/colyseus/plugin.cfg", "res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
