# Godot 4 cache and import data — never commit
.godot/

# Android export — generated Gradle project + version marker (never hand-authored)
# Ignore everything inside android/ except the handwritten build tool
android/*
!android/fix_apk.py

# Export presets: DO commit export_presets.cfg — contains permissions,
# architectures, and custom features (e.g. fogbound_emulator) that affect
# every build. Exported binaries are in builds/ (gitignored at repo root).
*.apk
*.aab
*.ipa
*.dmg
*.exe
*.x86_64
*.app
